# Maintainer: guttermonk <guttermonk@protonmail.com>
#
# Template, not a working PKGBUILD. @PKGVER@ and @SHA256@ are filled in by the
# release workflow, which is the only place that can know the second of them:
# it is the checksum of a tarball that does not exist until that run has built
# it. The rendered file is attached to each release as PKGBUILD.
#
# To put it on the AUR, makepkg --printsrcinfo > .SRCINFO beside it and commit
# both. .SRCINFO cannot be generated by the workflow, makepkg being an Arch
# tool and the runners being Ubuntu.

pkgname=slappyshot-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Screenshot annotation tool'
arch=('x86_64')
url='https://github.com/guttermonk/slappyshot'
license=('MPL-2.0')

# Written out by hand, as everywhere else this is packaged, and for the same
# reason: nothing but libc, libm and libgcc_s is in the binary's DT_NEEDED.
# EGL, GL, xkbcommon and the display protocol all arrive by dlopen, so namcap
# will not find any of this on its own.
#
# wayland is a depends and libx11 an optdepends rather than the other way
# round, this being a Wayland tool first -- but either satisfies it at runtime,
# and any X11 desktop has libx11 regardless. There is no way to say "one of
# these two" in a PKGBUILD; the rpm packaging says it with a rich dependency
# and the deb with an alternation.
depends=('libglvnd' 'libxkbcommon' 'wayland')
optdepends=(
  'libx11: running under X11 rather than Wayland'
  'grim: capturing the screenshot to pipe in'
  'slurp: choosing the region for grim'
  'wl-clipboard: copy_command = "wl-copy"'
)

provides=('slappyshot')
conflicts=('slappyshot')

# No makedepends and no build(): this is the released binary, already built.
source=("slappyshot-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/slappyshot-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA256@')

package() {
  # No cd: the release tarball is flat -- it is rolled up with `tar -C <stage>
  # .` -- so everything extracts straight into $srcdir, which is where makepkg
  # starts this function.
  install -Dm755 slappyshot "${pkgdir}/usr/bin/slappyshot"
  install -Dm644 man/slappyshot.1 "${pkgdir}/usr/share/man/man1/slappyshot.1"
  install -Dm644 slappyshot.desktop \
    "${pkgdir}/usr/share/applications/slappyshot.desktop"
  install -Dm644 assets/slappyshot.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/slappyshot.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/slappyshot/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/slappyshot/README.md"
}
