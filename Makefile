ifeq ($(PREFIX),)
    PREFIX := /usr/local
endif

SOURCEDIRS:=src $(wildcard src/*)
SOURCEFILES:=$(foreach d,$(SOURCEDIRS),$(wildcard $(d)/*.rs))

BINDIR:=$(PREFIX)/bin
MANDIR:=$(PREFIX)/share/man/man1

# The manpage is generated by build.rs into OUT_DIR, whose name carries a hash,
# so it has to be looked for rather than named. See build.rs.
MANPAGE=$(shell find target/release/build -name slappyshot.1 2>/dev/null | head -1)

.PHONY: build build-release clean install uninstall fix

build: $(SOURCEFILES) Cargo.lock Cargo.toml
	cargo build

build-release: $(SOURCEFILES) Cargo.lock Cargo.toml
	cargo build --release

clean:
	cargo clean

install: build-release
	install -s -Dm755 target/release/slappyshot -t $(BINDIR)
	install -Dm644 slappyshot.desktop $(PREFIX)/share/applications/slappyshot.desktop
	install -Dm644 assets/slappyshot.png $(PREFIX)/share/icons/hicolor/256x256/apps/slappyshot.png
	install -Dm644 LICENSE $(PREFIX)/share/licenses/slappyshot/LICENSE
	install -Dm644 $(MANPAGE) $(MANDIR)/slappyshot.1

uninstall:
	rm -f $(BINDIR)/slappyshot
	rm -f $(PREFIX)/share/applications/slappyshot.desktop
	rm -f $(PREFIX)/share/icons/hicolor/256x256/apps/slappyshot.png
	rm -f $(PREFIX)/share/licenses/slappyshot/LICENSE
	rmdir -p $(PREFIX)/share/licenses/slappyshot 2>/dev/null || true
	rm -f $(MANDIR)/slappyshot.1

fix:
	cargo fmt --all
	cargo clippy --fix --allow-dirty --all-targets --all-features -- -D warnings
